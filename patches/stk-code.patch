diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4e5618d..a913c28 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,6 +4,22 @@ cmake_minimum_required(VERSION 3.12...4.0)
 project(SuperTuxKart)
 set(PROJECT_VERSION "git")
 
+# The game recognises its data directory by a file called
+# supertuxkart.<version>, so a build calling itself "git" cannot see assets
+# from a numbered release. Taking the version from whatever is in the asset
+# tree keeps the two in step; STK_ASSET_DIR is set by the PS5 build.
+if(STK_ASSET_DIR)
+    file(GLOB stk_version_files "${STK_ASSET_DIR}/supertuxkart.*")
+    foreach(candidate IN LISTS stk_version_files)
+        get_filename_component(stk_version_name "${candidate}" NAME)
+        string(REGEX REPLACE "^supertuxkart\\." "" stk_version "${stk_version_name}")
+        if(stk_version MATCHES "^[0-9]+\\.[0-9]+$")
+            set(PROJECT_VERSION "${stk_version}")
+            message(STATUS "Version ${stk_version} taken from the asset tree")
+        endif()
+    endforeach()
+endif()
+
 add_definitions( -DSUPERTUXKART_VERSION="${PROJECT_VERSION}" )
 
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${PROJECT_SOURCE_DIR}/cmake")
@@ -547,6 +563,13 @@ endif()
 # Provides list of source and header files (STK_SOURCES and STK_HEADERS)
 include(sources.cmake)
 
+if (PROSPERO_SUPPORT_SOURCES)
+    # PS5: a log that survives having nowhere to print, and the allocator that
+    # gives the game more than the sandbox libc heap holds. Set by the
+    # out-of-tree ps5-gl.cmake, so an ordinary build never sees this.
+    set(STK_SOURCES ${STK_SOURCES} ${PROSPERO_SUPPORT_SOURCES})
+endif()
+
 if (USE_APPLE_NETWORK_LIBRARIES)
     add_definitions(-DAPPLE_NETWORK_LIBRARIES)
     set(STK_SOURCES
@@ -640,6 +663,14 @@ else()
         endif()
     else()
         add_executable(supertuxkart ${STK_SOURCES} ${STK_RESOURCES} ${STK_HEADERS})
+
+if (PS5_FINAL_LINK_FLAGS)
+    # Only the game executable gets the custom entry point and linker layout;
+    # CMake's feature tests must keep building with the ordinary ones.
+    set_property(TARGET supertuxkart APPEND_STRING
+                 PROPERTY LINK_FLAGS " ${PS5_FINAL_LINK_FLAGS}")
+endif()
+
     endif()
     if (NOT WIN32)
         target_link_libraries(supertuxkart ${PTHREAD_LIBRARY})
