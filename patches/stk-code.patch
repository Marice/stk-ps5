 bool CentralVideoSettings::isARBBufferStorageUsable() const
 {
+#ifdef __PROSPERO__
+    // The PS5 driver keeps GPU data in CPU memory and writes the CPU caches
+    // back before the GPU reads. It remembers what it already published, but
+    // not for persistently mapped buffers: those are written back in full on
+    // every draw that uses them ("persistent mappings keep their per-use
+    // publication", ps5_screen.c). STK maps its instance and skinning data
+    // that way when buffer storage is available, so without it STK uses
+    // glBufferSubData, and only the bytes written are published.
+    return false;
+#else
     return hasBufferStorage;
+#endif
 }
 
