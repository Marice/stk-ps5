+// The PS5 OpenGL SDK hands out one full-screen surface through EGL; there is
+// no window to create, and SDL's video driver does not run inside a title.
+// OliSe Player draws the same way.
+static EGLDisplay g_ps5_display = EGL_NO_DISPLAY;
+static EGLSurface g_ps5_surface = EGL_NO_SURFACE;
+static EGLContext g_ps5_context = EGL_NO_CONTEXT;
+
+void* ps5GLGetProcAddress(const char* name)
+{
+	return (void*)eglGetProcAddress(name);
+}
+
+void ps5GLSwapBuffers()
+{
+	if (g_ps5_surface != EGL_NO_SURFACE)
+		eglSwapBuffers(g_ps5_display, g_ps5_surface);
+}
+
+void ps5GLSetSwapInterval(int interval)
+{
+	if (g_ps5_display != EGL_NO_DISPLAY)
+		eglSwapInterval(g_ps5_display, interval);
+}
+
+static void* ps5GLLoad(const char* name)
+{
+	return ps5GLGetProcAddress(name);
+}
+
+// Creates the display, surface and an OpenGL 4.3 core context, and reports
+// the size of the screen. False when any step fails; each says which.
+static bool ps5CreateGLContext(u32* width, u32* height)
+{
+	fprintf(stderr, "stk:     egl: creating the display\n");
+	(void)sceSystemServiceHideSplashScreen();
+
+	g_ps5_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	EGLint major = 0, minor = 0;
+	if (g_ps5_display == EGL_NO_DISPLAY || !eglInitialize(g_ps5_display, &major, &minor))
+	{
+		fprintf(stderr, "stk:     egl: no display (0x%x)\n", eglGetError());
+		return false;
+	}
+	fprintf(stderr, "stk:     egl: EGL %d.%d\n", major, minor);
+	if (!eglBindAPI(EGL_OPENGL_API))
+	{
+		fprintf(stderr, "stk:     egl: eglBindAPI failed (0x%x)\n", eglGetError());
+		return false;
+	}
+
+	// The game draws into its own framebuffers, but the menus and the
+	// fallback renderer use the default one and need depth and stencil.
+	// A config without them is still better than none.
+	const EGLint with_depth[] = {
+		EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+		EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+		EGL_DEPTH_SIZE, 24, EGL_STENCIL_SIZE, 8,
+		EGL_NONE,
+	};
+	const EGLint without_depth[] = {
+		EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+		EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+		EGL_NONE,
+	};
+	EGLConfig config = NULL;
+	EGLint count = 0;
+	if (!eglChooseConfig(g_ps5_display, with_depth, &config, 1, &count) || count < 1)
+	{
+		fprintf(stderr, "stk:     egl: no config with depth and stencil, trying without\n");
+		if (!eglChooseConfig(g_ps5_display, without_depth, &config, 1, &count) || count < 1)
+		{
+			fprintf(stderr, "stk:     egl: no config (0x%x)\n", eglGetError());
+			return false;
+		}
+	}
+
+	g_ps5_surface = eglCreateWindowSurface(g_ps5_display, config, 0, NULL);
+	if (g_ps5_surface == EGL_NO_SURFACE)
+	{
+		fprintf(stderr, "stk:     egl: no surface (0x%x)\n", eglGetError());
+		return false;
+	}
+
+	const EGLint context_attributes[] = {
+		EGL_CONTEXT_MAJOR_VERSION_KHR, 4,
+		EGL_CONTEXT_MINOR_VERSION_KHR, 3,
+		EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT_KHR,
+		EGL_NONE,
+	};
+	g_ps5_context = eglCreateContext(g_ps5_display, config, EGL_NO_CONTEXT, context_attributes);
+	if (g_ps5_context == EGL_NO_CONTEXT)
+	{
+		fprintf(stderr, "stk:     egl: no context (0x%x)\n", eglGetError());
+		return false;
+	}
+	if (!eglMakeCurrent(g_ps5_display, g_ps5_surface, g_ps5_surface, g_ps5_context))
+	{
+		fprintf(stderr, "stk:     egl: eglMakeCurrent failed (0x%x)\n", eglGetError());
+		return false;
+	}
+
+	EGLint w = 0, h = 0;
+	eglQuerySurface(g_ps5_display, g_ps5_surface, EGL_WIDTH, &w);
+	eglQuerySurface(g_ps5_display, g_ps5_surface, EGL_HEIGHT, &h);
+	*width = (u32)w;
+	*height = (u32)h;
+	fprintf(stderr, "stk:     egl: surface %dx%d, loading OpenGL\n", w, h);
+
+	if (gladLoadGL((GLADloadfunc)ps5GLLoad) == 0)
+	{
+		fprintf(stderr, "stk:     egl: gladLoadGL failed\n");
+		return false;
+	}
+	fprintf(stderr, "stk:     egl: %s\n", (const char*)glGetString(GL_VERSION));
+	return true;
+}
